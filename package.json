{
  "name": "tug-of-war-live",
  "version": "1.1.0",
  "type": "module",
  "description": "Friendly 3D food tug of war overlay for live streams (unofficial, not affiliated with TikTok)",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node server.js",
    "test": "cross-env DEMO_MODE=1 node server.js",
